# Absolute path to your manga library root on this server
MANGA_ROOT=/mnt/jellyfin/Manga

# Optional arc cache path for /api/library/series/{series_id}/arcs
ARC_INDEX_ROOT=/home/mhales/manga-reader/backend/arc_index
# Optional per-series arc template path used for new unknown series
ARC_TEMPLATE_ROOT=/home/mhales/manga-reader/backend/arc_templates
# Arc auto-sync behavior: run once at startup and then every N seconds (0 disables loop)
ARC_SYNC_ON_STARTUP=true
ARC_SYNC_INTERVAL_SECONDS=300

# Comma-separated origins allowed for CORS. Use * for LAN prototyping.
CORS_ALLOW_ORIGINS=*

# API bind options
HOST=0.0.0.0
PORT=8080
